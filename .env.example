# Google OAuth 2.0 Multi-User Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set the deployment administrator explicitly. Empty disables admin access.
ADMIN_EMAIL=
# Use a random, high-entropy server secret for encrypted login sessions.
AUTH_SECRET=

# Server-only Google Apps Script Web App (for Admin ledger & Admin user registry)
APPS_SCRIPT_URL=
APPS_SCRIPT_API_KEY=
CASHFLOW_PROXY_TOKEN=

# Gemini API key for AI quick input and receipt OCR (Server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional four-digit app lock PIN
NEXT_PUBLIC_APP_PIN=0000
