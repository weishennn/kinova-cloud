# Google OAuth 2.0 Multi-User Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set the deployment administrator explicitly. Empty disables admin access.
ADMIN_EMAIL=
# Use a random, high-entropy server secret for encrypted login sessions.
AUTH_SECRET=

# Server-only Google Apps Script Web App (for Admin ledger & Admin user registry)
APPS_SCRIPT_URL=
APPS_SCRIPT_API_KEY=
CASHFLOW_PROXY_TOKEN=
KINOVA_SHORTCUT_TOKEN=

# Gemini API key(s) for AI quick input and receipt OCR (Server-side only)
# Supports 1 or more keys with automatic round-robin load balancing & 429 failover.
# Option A: Comma-separated in GEMINI_API_KEY or GEMINI_API_KEYS (e.g. key1,key2,key3)
# Option B: Numbered variables GEMINI_API_KEY_1, GEMINI_API_KEY_2, GEMINI_API_KEY_3...
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash
# Optional; online receipt-item price checks use Google Search grounding only when requested.
GEMINI_PRICE_SEARCH_MODEL=gemini-2.5-flash

# Optional Trixpense Trip Sync URL
NEXT_PUBLIC_SPLITWISE_APP_URL=
